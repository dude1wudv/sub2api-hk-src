[Unit]
Description=Sync channel quality outputs
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/sub2api-external-quality/sync.py
UMask=0077
TimeoutStartSec=180
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sub2api-external-quality
StandardOutput=journal
StandardError=journal
